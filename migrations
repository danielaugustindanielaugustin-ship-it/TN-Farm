/*
# TNFarm - Tamil Nadu Farmers Social Commerce Platform

## Overview
Creates the full schema for TNFarm, an Instagram-style farmer discovery platform.
Customers discover farmers, view products, chat, and visit farms directly — no ordering,
cart, payment, or delivery. Three roles: farmer, customer, admin.

## New Tables
1. profiles — extends auth.users with role, name, avatar, bio, village, district, organic status, farming experience
2. farms — farm details (cover, description, GPS lat/lng, address) linked to a farmer
3. categories — product categories (vegetables, fruits, grains, dairy, spices)
4. products — farm products with image, price, quantity, harvest date, organic badge
5. posts — social posts (photo/reel/video) by farmers
6. comments — comments on posts
7. likes — likes on posts (unique per user per post)
8. follows — customer follows farmer (unique per pair)
9. messages — chat messages between users (text + image)
10. reviews — customer ratings/reviews of farmers
11. notifications — user notifications
12. saved_products — customer saved/favorite products
13. saved_posts — customer saved posts
14. recently_viewed — customer recently viewed products

## Security
- RLS enabled on every table.
- All content is readable by any authenticated user (social/public discovery model).
- Writes are owner-scoped: each user can only insert/update/delete their own rows
  (own profile, own farm, own products, own posts, own comments, own likes, own follows,
   own messages they send, own reviews, own saves, own notifications).
- Owner columns default to auth.uid() so inserts omitting the owner still satisfy WITH CHECK.
*/

-- profiles
CREATE TABLE IF NOT EXISTS profiles (
  id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  role text NOT NULL DEFAULT 'customer' CHECK (role IN ('farmer', 'customer', 'admin')),
  name text NOT NULL DEFAULT '',
  avatar_url text,
  phone text,
  bio text,
  village text,
  district text,
  organic_status text DEFAULT 'conventional' CHECK (organic_status IN ('organic', 'conventional', 'in_conversion')),
  farming_experience int DEFAULT 0,
  verified boolean NOT NULL DEFAULT false,
  created_at timestamptz NOT NULL DEFAULT now()
);
ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "profiles_select_all" ON profiles;
CREATE POLICY "profiles_select_all" ON profiles FOR SELECT TO authenticated USING (true);

DROP POLICY IF EXISTS "profiles_insert_own" ON profiles;
CREATE POLICY "profiles_insert_own" ON profiles FOR INSERT TO authenticated WITH CHECK (auth.uid() = id);

DROP POLICY IF EXISTS "profiles_update_own" ON profiles;
CREATE POLICY "profiles_update_own" ON profiles FOR UPDATE TO authenticated USING (auth.uid() = id) WITH CHECK (auth.uid() = id);

